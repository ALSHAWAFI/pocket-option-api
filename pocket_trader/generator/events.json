        },
        {
            "name": "cancel_pending_deal",
            "event": "cancelPendingOrder",
            "args": {
                "name": "deal_id",
                "type": "str"
            },
            "doc": "Cancel a pending deal"
        },
        {
            "name": "copy_signal",
            "event": "copySignalOrder",
            "args": {
                "name": "data",
                "type": "models.CopySignalRequest"
