        },
        {
            "name": "get_history",
            "event": "getHistory",
            "args": {
                "name": "data",
                "type": "dict"
            },
            "doc": "Request trading history"
        },
        {
            "name": "get_assets",
            "event": "getAssets",
            "doc": "Request available assets"
        },
        {
            "name": "get_balance",
            "event": "getBalance",
            "doc": "Request current balance"
        }
