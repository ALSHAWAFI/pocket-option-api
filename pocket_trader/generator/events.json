        },
        {
            "name": "subscribe_for_market_sentiment",
            "event": "subfor",
            "args": {
                "name": "asset",
                "type": "models.Asset"
            },
            "doc": "Subscribe to market sentiment for asset"
        },
        {
            "name": "unsubscribe_for_market_sentiment",
            "event": "unsubfor",
            "args": {
                "name": "asset",
                "type": "models.Asset"
            },
            "doc": "Unsubscribe from market sentiment"
        },
        {
            "name": "change_asset",
            "event": "changeSymbol",
            "args": {
                "name": "data",
                "type": "models.ChangeAssetRequest"
            },
            "doc": "Change current asset"
        },
        {
            "name": "open_deal",
            "event": "openOrder",
            "args": {
                "name": "data",
                "type": "models.OpenDealRequest"
            },
            "doc": "Open a new deal/trade"
        },
        {
            "name": "close_deal",
            "event": "closeOrder",
            "args": {
                "name": "deal_id",
                "type": "str"
            },
