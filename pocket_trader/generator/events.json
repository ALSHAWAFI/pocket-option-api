    "emit": [
        {
            "name": "ps",
            "event": "ps",
            "doc": "Send ping to server"
        },
        {
            "name": "indicator_load",
            "event": "indicator/load",
            "doc": "Load indicators"
        },
        {
            "name": "favorite_load",
            "event": "favorite/load",
            "doc": "Load favorites"
        },
        {
            "name": "price_alert_load",
            "event": "price-alert/load",
            "doc": "Load price alerts"
        },
        {
            "name": "auth",
            "event": "auth",
            "args": {
                "name": "data",
                "type": "models.AuthorizationData"
            },
            "doc": "Authenticate with server"
        },
        {
            "name": "subscribe_to_asset",
            "event": "subscribeSymbol",
            "args": {
                "name": "asset",
                "type": "models.Asset"
            },
            "doc": "Subscribe to asset for real-time updates"
        },
        {
            "name": "unsubscribe_from_asset",
            "event": "unsubscribeSymbol",
            "args": {
                "name": "asset",
                "type": "models.Asset"
            },
