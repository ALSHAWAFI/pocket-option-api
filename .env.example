# Pocket Option Configuration
# Copy this file as .env and then edit the values

# Required - session ID from the browser
# Example: PO_SESSION=4u9d6kfghfghfghfhgfhgf
PO_SESSION=your_session_id_here

# Required - your User ID
# Example: PO_UID=1679898790
PO_UID=0

# Trading mode (true/false)
# true = demo account, false = real account
IS_DEMO=true

# Server region (demo, eu, us, asia)
# demo: wss://demo-api-eu.po.market
# eu: wss://api-eu.po.market
PO_REGION=demo

# ========== Risk management settings ==========
# Starting balance (for risk calculation)
INITIAL_BALANCE=1000

# Max risk per trade (0.02 = 2%)
MAX_RISK_PER_TRADE=0.02

# Max number of trades per day
MAX_DAILY_TRADES=10